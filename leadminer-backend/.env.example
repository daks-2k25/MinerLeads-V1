# Ambiente da aplicação
NODE_ENV=development
PORT=3001

# Origem permitida para CORS (frontend Next.js)
CORS_ORIGIN=http://localhost:3000

# Prisma / PostgreSQL (Neon)
# DATABASE_URL: conexão via pooler (PgBouncer) do Neon — usada pela aplicação em runtime
# (host contém "-pooler"). Necessário sslmode=require e pgbouncer=true.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/leadminer?sslmode=require&pgbouncer=true"
# DIRECT_URL: conexão direta (sem pooler) do Neon — usada só pelo Prisma CLI
# (migrate/introspect), evita que o PgBouncer interfira em operações DDL.
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.regiao.aws.neon.tech/leadminer?sslmode=require"

# Auth (estrutura pronta, login ainda não implementado)
JWT_SECRET=defina-um-segredo-forte-aqui
JWT_EXPIRES_IN=1d

# Google Places API (New) - fonte de leads da V1 (integração ainda não implementada)
GOOGLE_PLACES_API_KEY=defina-sua-chave-da-google-places-api-aqui
